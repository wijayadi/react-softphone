{
  "name": "@sengsara/react-softphone",
  "version": "3.2.0",
  "description": "Webrtc Softphone React",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.es.js",
  "jsnext:main": "dist/index.es.js",
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c --watch",
    "lint": "oxlint src",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "pack": "npm pack",
    "prepack": "npm run build",
    "release": "npx np"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wijayadi/react-softphone.git"
  },
  "keywords": [
    "React",
    "WebRTC",
    "Softphone",
    "VoIP",
    "SIP",
    "JsSIP",
    "Phone",
    "Calling"
  ],
  "author": "Dionis",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/wijayadi/react-softphone/issues"
  },
  "homepage": "https://github.com/wijayadi/react-softphone#readme",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@mui/system": "^5.18.0",
    "@phosphor-icons/react": "^2.1.10",
    "jssip": "^3.13.8",
    "lodash": "^4.18.1",
    "luxon": "^3.7.2"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.1.1",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.1.1"
  },
  "sideEffects": false,
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/chamuridis"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": ">=0.25.0",
    "oxlint": "^1.87.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rollup": "^4.64.3",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "vite": "^8.3.4"
  }
}
