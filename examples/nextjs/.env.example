# ---------------------------------------------------------------------------
# React Softphone - SIP credentials
# Copy this file to `.env` and replace the values with your own SIP server.
#   cp .env.example .env
#
# NOTE: Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# WebRTC/SIP runs in the browser, so the softphone config must be public.
# ---------------------------------------------------------------------------

# SIP server host / domain (without scheme)
NEXT_PUBLIC_SIP_DOMAIN=your-sip-server.com

# SIP user / extension
NEXT_PUBLIC_SIP_EXTENSION=1001

# SIP password / secret
NEXT_PUBLIC_SIP_PASSWORD=your-sip-password

# SIP WebSocket server used by JsSIP (usually wss://<domain>:8089/ws)
NEXT_PUBLIC_SIP_WS_SERVER=wss://your-sip-server.com:8089/ws

# Display name shown on outgoing/incoming calls
NEXT_PUBLIC_SIP_DISPLAY_NAME=1001

# Set to "true" to enable verbose JsSIP logging
NEXT_PUBLIC_SIP_DEBUG=false
